#!/bin/zsh
# Staples a notarization ticket to an app or DMG, retrying because Apple's ticket
# service sometimes lags behind an accepted submission or drops the connection.
#   ./Scripts/staple <NotchLing.app|NotchLing.dmg>
# STAPLE_ATTEMPTS and STAPLE_DELAY (seconds) override the defaults of 6 and 20.
set -uo pipefail

TARGET="${1:?Usage: staple <app-or-dmg>}"
ATTEMPTS="${STAPLE_ATTEMPTS:-6}"
DELAY="${STAPLE_DELAY:-20}"

for (( attempt = 1; attempt <= ATTEMPTS; attempt++ )); do
  if xcrun stapler staple "$TARGET"; then exit 0; fi
  if (( attempt < ATTEMPTS )); then
    echo "Stapling $(basename "$TARGET") failed (attempt $attempt of $ATTEMPTS); retrying in ${DELAY}s..." >&2
    sleep "$DELAY"
  fi
done
echo "Could not staple $(basename "$TARGET") after $ATTEMPTS attempts." >&2
exit 1
